[
  {
    "name": "theme_info",
    "theme_name": "VitalGLP Vivami Pro 2.0",
    "theme_version": "2.0.0",
    "theme_author": "VitalGLP Team",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "mailto:contact-fr@vivami.co"
  },
  {
    "name": "Identité Visuelle & Couleurs",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Couleur principale (Émeraude)",
        "default": "#059669"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Couleur secondaire (Vert Sombre)",
        "default": "#064e3b"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur accent (Ambre / Promotion)",
        "default": "#f59e0b"
      },
      {
        "type": "color",
        "id": "color_urgency",
        "label": "Couleur urgence flash (Rose / Rouge)",
        "default": "#ef4444"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo de la pharmacie"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px",
        "label": "Largeur du logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Bande d'Urgence & Offre Flash",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_urgency_timer",
        "label": "Activer le compte à rebours d'urgence",
        "default": true
      },
      {
        "type": "text",
        "id": "urgency_text",
        "label": "Texte d'urgence",
        "default": "Offre flash expire dans :"
      },
      {
        "type": "range",
        "id": "urgency_minutes",
        "min": 5,
        "max": 60,
        "step": 1,
        "default": 14,
        "unit": "min",
        "label": "Durée du compte à rebours"
      }
    ]
  },
  {
    "name": "Contact & Pharmacie",
    "settings": [
      {
        "type": "text",
        "id": "support_email",
        "label": "Email de contact",
        "default": "contact-fr@vivami.co"
      },
      {
        "type": "text",
        "id": "pharmacy_license",
        "label": "Numéro d'agrément officiel",
        "default": "Pharmacie En Ligne Enregistrée UE n° 441029"
      },
      {
        "type": "text",
        "id": "trustpilot_score",
        "label": "Score Trustpilot",
        "default": "4,6 / 5"
      },
      {
        "type": "text",
        "id": "trustpilot_review_count",
        "label": "Nombre d'avis Trustpilot",
        "default": "7 426 avis clients"
      }
    ]
  }
]
