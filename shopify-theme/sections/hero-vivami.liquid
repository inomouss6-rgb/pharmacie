<section id="hero" class="relative bg-gradient-to-b from-emerald-950 via-emerald-900 to-slate-900 text-white py-12 lg:py-20 overflow-hidden">
  
  <!-- Subtle decorative background glows -->
  <div class="pointer-events-none absolute -top-40 -right-40 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 -left-20 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Value Proposition & Urgency -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Trust badge & Urgency -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-800/80 border border-emerald-600/50 text-emerald-200 text-xs font-semibold backdrop-blur-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Pharmacie Agréée &bull; Délivrance avec Suivi Médical</span>
          </div>

          {% render 'flash-sale-urgency', class: 'bg-white/95 text-rose-800 border-white' %}
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white">
          Traitements Perte de Poids
          <span class="block bg-gradient-to-r from-emerald-300 via-teal-200 to-amber-200 bg-clip-text text-transparent">
            GLP-1 Authentiques & Scellés
          </span>
        </h1>

        <p class="text-sm sm:text-base text-emerald-100/90 max-w-2xl leading-relaxed">
          Commandez votre traitement officiel (<strong>Wegovy® FlexTouch®</strong>, <strong>Mounjaro® KwikPen®</strong> ou <strong>Zepbound®</strong>). Ordonnance médicale vérifiée par nos médecins partenaires, expédié sous chaîne du froid 2-8°C en 24h.
        </p>

        <!-- Feature Pills Contract -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs">
          <div class="p-3 rounded-xl bg-white/10 backdrop-blur-xs border border-white/10 flex items-center gap-2">
            <span class="text-lg">❄️</span>
            <div>
              <div class="font-extrabold text-white">Froid 2-8°C</div>
              <div class="text-[10px] text-emerald-200">Chronofresh actif</div>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-white/10 backdrop-blur-xs border border-white/10 flex items-center gap-2">
            <span class="text-lg">📋</span>
            <div>
              <div class="font-extrabold text-white">Sans attente</div>
              <div class="text-[10px] text-emerald-200">Validation en ligne</div>
            </div>
          </div>

          <div class="col-span-2 sm:col-span-1 p-3 rounded-xl bg-white/10 backdrop-blur-xs border border-white/10 flex items-center gap-2">
            <span class="text-lg">🛡️</span>
            <div>
              <div class="font-extrabold text-white">Traçabilité UE</div>
              <div class="text-[10px] text-emerald-200">Laboratoires d'origine</div>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="#bundles" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black rounded-xl shadow-xl shadow-emerald-500/30 transition-all text-center flex items-center justify-center gap-2 text-sm sm:text-base group">
            <span>Découvrir les Packs & Tarifs Dégressifs</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>

          <a href="#transformations" class="w-full sm:w-auto px-6 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/15 transition-all text-center text-sm flex items-center justify-center gap-2">
            <span>Voir les 11 Transformations</span>
            <span class="text-xs bg-emerald-500/40 text-emerald-200 px-2 py-0.5 rounded-full font-bold">Photos réelles</span>
          </a>
        </div>

        <!-- Trustpilot Hero Badge -->
        <div class="pt-2 flex items-center justify-center lg:justify-start gap-3">
          {% render 'trustpilot-badge', class: 'text-white' %}
        </div>

      </div>

      <!-- Right Column: Interactive Featured Showcase Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/20 text-slate-900">
          
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div>
              <span class="text-[11px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                Le Plus Demandé
              </span>
              <h3 class="text-xl font-extrabold text-slate-900 mt-1">Wegovy® FlexTouch®</h3>
            </div>
            <div class="text-right">
              <span class="text-xs text-slate-400 line-through">359,00 €</span>
              <div class="text-2xl font-black text-emerald-700">299,00 €</div>
            </div>
          </div>

          <div class="flex justify-center mb-6 bg-slate-50 rounded-2xl p-4 border border-slate-100">
            <img src="{{ '436_1_14ba29ab.jpeg' | asset_url }}" alt="Wegovy FlexTouch Pen" class="max-h-48 object-contain mix-blend-multiply">
          </div>

          <div class="space-y-4">
            <div class="bg-emerald-50 rounded-xl p-3 border border-emerald-200/60 text-xs text-emerald-900 space-y-1">
              <div class="font-extrabold flex items-center gap-1.5">
                <span>🎁</span>
                <span>Offre Pack 2 Boîtes Recommandée :</span>
              </div>
              <p class="text-[11px] text-emerald-800">
                Économisez <strong>-15% immédiats</strong> + livraison réfrigérée Chronofresh offerte + pochette isotherme nomade incluse !
              </p>
            </div>

            <a href="#catalogue" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-black text-sm rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2">
              <span>Commander Ce Traitement</span>
              <span>&rarr;</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière Hero Vivami",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Traitements Perte de Poids GLP-1 Authentiques & Scellés"
    }
  ]
}
{% endschema %}
