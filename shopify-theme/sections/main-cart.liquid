<section class="py-12 bg-white max-w-4xl mx-auto px-4 sm:px-6">
  <div class="space-y-6">
    <div class="border-b border-slate-200 pb-4">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900">
        {{ 'cart.title' | t | default: 'Votre Panier Médical Sécurisé' }}
      </h1>
      <p class="text-xs text-slate-500 mt-1">Traitements préparés sous contrôle pharmaceutique et expédiés sous chaîne du froid 2-8°C.</p>
    </div>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" class="space-y-6">
        
        <!-- Free shipping bar -->
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs font-bold text-emerald-900">
            <span>🚚</span>
            <span>Livraison réfrigérée Chronofresh OFFERTE !</span>
          </div>
          <span class="text-xs font-extrabold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-full">
            Économie de 19,90 €
          </span>
        </div>

        <!-- Items Table -->
        <div class="divide-y divide-slate-100 border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-2xs">
          {% for item in cart.items %}
            <div class="p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-4 w-full sm:w-auto">
                <div class="w-20 h-20 bg-slate-50 rounded-xl p-2 border border-slate-100 flex-shrink-0 flex items-center justify-center">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="max-h-full object-contain mix-blend-multiply">
                  {% else %}
                    <img src="{{ '436_1_14ba29ab.jpeg' | asset_url }}" alt="{{ item.title | escape }}" class="max-h-full object-contain mix-blend-multiply">
                  {% endif %}
                </div>
                <div>
                  <h3 class="font-extrabold text-slate-900 text-sm sm:text-base">{{ item.product.title }}</h3>
                  <div class="text-xs text-slate-500 mt-0.5">
                    Variante : <span class="font-semibold text-slate-800">{{ item.variant.title }}</span>
                  </div>
                  <div class="text-xs font-bold text-emerald-700 mt-1">
                    {{ item.final_price | money }} / boîte
                  </div>
                </div>
              </div>

              <!-- Quantity and Subtotal -->
              <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto">
                <div class="flex items-center border border-slate-200 rounded-lg overflow-hidden bg-slate-50">
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="px-3 py-1.5 text-slate-600 hover:bg-slate-200 font-bold text-xs">-</a>
                  <span class="px-3 py-1.5 text-xs font-bold text-slate-900">{{ item.quantity }}</span>
                  <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="px-3 py-1.5 text-slate-600 hover:bg-slate-200 font-bold text-xs">+</a>
                </div>

                <div class="text-right">
                  <div class="text-base sm:text-lg font-black text-slate-900">
                    {{ item.final_line_price | money }}
                  </div>
                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-[11px] text-rose-600 hover:underline">
                    Supprimer
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Summary & Checkout -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 space-y-4">
          <div class="flex items-center justify-between text-base sm:text-lg font-extrabold text-slate-900">
            <span>{{ 'cart.subtotal' | t | default: 'Total de votre commande' }}</span>
            <span class="text-2xl font-black text-emerald-800">{{ cart.total_price | money }}</span>
          </div>

          <p class="text-xs text-slate-500">
            {{ 'cart.terms_note' | t | default: 'Validation médicale obligatoire par un pharmacien diplômé avant expédition sous chaîne du froid.' }}
          </p>

          <button type="submit" name="checkout" class="w-full py-4 px-6 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-black text-base rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer">
            <span>{{ 'cart.checkout' | t | default: 'Finaliser Ma Commande Sécurisée' }}</span>
            <span>&rarr;</span>
          </button>

          <div class="pt-2 text-center">
            {% render 'payment-icons' %}
          </div>
        </div>

      </form>
    {% else %}
      <div class="text-center py-16 bg-slate-50 rounded-3xl border border-slate-200 space-y-4">
        <div class="text-5xl">🛍️</div>
        <h2 class="text-xl font-extrabold text-slate-900">{{ 'cart.empty' | t | default: 'Votre panier est actuellement vide' }}</h2>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Découvrez notre gamme de traitements GLP-1 certifiés et profitez de réductions jusqu'à -30% sur vos packs de cure.
        </p>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl shadow-md transition-all">
          <span>Découvrir les Traitements</span>
          <span>&rarr;</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Page Panier Principale",
  "settings": []
}
{% endschema %}
