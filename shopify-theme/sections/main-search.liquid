<section class="py-12 max-w-7xl mx-auto px-4 sm:px-6">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <h1 class="text-3xl font-black text-slate-900 mb-4">Résultats de Recherche</h1>
    
    <form action="/search" method="get" class="flex gap-2">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher un traitement (Wegovy, Mounjaro...)" class="flex-grow bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20">
      <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl transition-colors">
        Rechercher
      </button>
    </form>
  </div>

  {% if search.performed %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% else %}
        <div class="col-span-full text-center py-12 text-slate-500 text-sm">
          Aucun résultat pour « {{ search.terms }} ».
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
