<section id="catalogue" class="py-16 max-w-7xl mx-auto px-4 sm:px-6">
  <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider">
      <span>🩺</span>
      <span>Catalogue Officiel des Traitements GLP-1</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Fiches Produits & Packs Cures Dégressifs
    </h2>

    <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
      Chaque traitement est proposé avec ses variantes (<strong>1 acheté, 2 achetés ou 5 achetés</strong>) pour s'adapter à la durée de votre cure. Choisissez votre dosage et bénéficiez de réductions immédiates.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for product in collections.all.products limit: 6 %}
      {% render 'product-card', product: product %}
    {% else %}
      <!-- Fallback display if products are not yet loaded in development store -->
      <div class="col-span-full text-center py-8">
        <p class="text-slate-500 text-sm">Les produits de votre boutique s'afficheront ici automatiquement.</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Grille Produits Bundles",
  "settings": []
}
{% endschema %}
