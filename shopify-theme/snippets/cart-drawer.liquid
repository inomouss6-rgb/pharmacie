<div id="CartDrawer" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 invisible" aria-hidden="true">
  <!-- Backdrop -->
  <div id="CartDrawerOverlay" class="absolute inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity cursor-pointer"></div>

  <!-- Drawer Container -->
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10 pointer-events-auto">
    <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col border-l border-slate-200 transform translate-x-full transition-transform duration-300 ease-in-out" id="CartDrawerContent">
      
      <!-- Drawer Header -->
      <div class="p-4 sm:p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-800 font-bold">
            🛒
          </div>
          <div>
            <h2 class="text-sm sm:text-base font-extrabold text-slate-900">
              {{ 'cart.title' | t | default: 'Votre Panier Médical Sécurisé' }}
            </h2>
            <p class="text-[11px] text-emerald-700 font-medium">Expédition sous chaîne du froid 2-8°C</p>
          </div>
        </div>
        <button id="CloseCartDrawer" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg transition-colors cursor-pointer" aria-label="Fermer le panier">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Free Shipping Meter -->
      <div class="bg-emerald-50 px-4 py-2.5 border-b border-emerald-100">
        <div class="flex items-center justify-between text-xs font-bold text-emerald-900 mb-1">
          <span class="flex items-center gap-1.5">
            <span>🚚</span>
            <span id="FreeShippingText">Livraison réfrigérée Chronofresh OFFERTE dès 2 boîtes !</span>
          </span>
          <span class="text-emerald-700" id="FreeShippingBadge">Actif</span>
        </div>
        <div class="w-full bg-emerald-200/60 rounded-full h-1.5 overflow-hidden">
          <div id="FreeShippingBar" class="bg-emerald-600 h-1.5 rounded-full transition-all duration-500" style="width: 100%;"></div>
        </div>
      </div>

      <!-- Drawer Body: Items list -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4" id="CartDrawerItems">
        <!-- Rendered dynamically by theme.js or liquid initial state -->
        <div class="text-center py-12 text-slate-500" id="CartEmptyState">
          <div class="text-4xl mb-3">🛍️</div>
          <p class="font-bold text-slate-800 text-sm">{{ 'cart.empty' | t | default: 'Votre panier est vide' }}</p>
          <p class="text-xs text-slate-500 mt-1">Sélectionnez votre traitement pour démarrer votre cure.</p>
        </div>
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50 space-y-3">
        <div class="flex items-center justify-between text-sm font-bold text-slate-700">
          <span>{{ 'cart.subtotal' | t | default: 'Sous-total' }}</span>
          <span class="text-xl font-extrabold text-slate-900" id="CartDrawerSubtotal">0,00 €</span>
        </div>

        <p class="text-[11px] text-slate-500 flex items-center gap-1">
          <span>🔒</span>
          <span>Paiement chiffré SSL 256 bits conforme norme bancaire PCI-DSS.</span>
        </p>

        <!-- Shopify Native Checkout Form -->
        <form action="/checkout" method="post" id="CartDrawerForm">
          <button type="submit" name="checkout" class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-extrabold rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
            <span>{{ 'cart.checkout' | t | default: 'Finaliser Ma Commande Sécurisée' }}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>

        <!-- Payment icons -->
        {% render 'payment-icons' %}
      </div>

    </div>
  </div>
</div>
