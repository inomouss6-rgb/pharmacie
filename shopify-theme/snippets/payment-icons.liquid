<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 {{ class }}">
  <!-- Carte Bancaire / Visa -->
  <div class="bg-white border border-slate-200 rounded-lg px-2.5 py-1 flex items-center shadow-2xs hover:border-slate-300 transition-colors" title="Visa / Carte Bancaire">
    <span class="font-black italic text-blue-800 text-xs sm:text-sm tracking-tight">VISA</span>
  </div>

  <!-- Mastercard -->
  <div class="bg-white border border-slate-200 rounded-lg px-2.5 py-1 flex items-center shadow-2xs hover:border-slate-300 transition-colors" title="Mastercard">
    <div class="flex items-center -space-x-1.5">
      <div class="w-3.5 h-3.5 rounded-full bg-red-500"></div>
      <div class="w-3.5 h-3.5 rounded-full bg-amber-400 opacity-90"></div>
    </div>
    <span class="text-[10px] font-bold text-slate-800 ml-1">Mastercard</span>
  </div>

  <!-- PayPal -->
  <div class="bg-white border border-slate-200 rounded-lg px-2.5 py-1 flex items-center gap-1 shadow-2xs hover:border-slate-300 transition-colors" title="PayPal">
    <span class="font-extrabold italic text-blue-700 text-xs tracking-tighter">Pay</span>
    <span class="font-extrabold italic text-sky-500 text-xs tracking-tighter">Pal</span>
  </div>

  <!-- Coupon Transcash -->
  <div class="bg-red-50 border border-red-200 rounded-lg px-2.5 py-1 flex items-center gap-1 shadow-2xs hover:border-red-300 transition-colors" title="Coupon Transcash accepté">
    <span class="w-2 h-2 rounded-full bg-red-600"></span>
    <span class="text-[11px] font-black text-red-900 tracking-tight">Transcash</span>
  </div>

  <!-- Coupon Google Play -->
  <div class="bg-emerald-50 border border-emerald-200 rounded-lg px-2.5 py-1 flex items-center gap-1 shadow-2xs hover:border-emerald-300 transition-colors" title="Coupon Google Play">
    <span class="text-xs">🎮</span>
    <span class="text-[11px] font-bold text-emerald-900 tracking-tight">Google Play</span>
  </div>

  <!-- Coupon Apple Gift -->
  <div class="bg-slate-100 border border-slate-300 rounded-lg px-2.5 py-1 flex items-center gap-1 shadow-2xs hover:border-slate-400 transition-colors" title="Coupon Apple Gift">
    <span class="text-xs">🍎</span>
    <span class="text-[11px] font-bold text-slate-900 tracking-tight">Apple Gift</span>
  </div>

  <!-- Virement Bancaire -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg px-2.5 py-1 flex items-center gap-1 shadow-2xs hover:border-blue-300 transition-colors" title="Virement bancaire sécurisé">
    <span class="text-xs">🏛️</span>
    <span class="text-[11px] font-bold text-blue-950 tracking-tight">Virement SEPA</span>
  </div>
</div>
