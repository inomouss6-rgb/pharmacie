<div class="inline-flex items-center gap-2 {{ class }}">
  <div class="flex items-center gap-0.5">
    {% for i in (1..5) %}
      <div class="w-4 h-4 sm:w-5 sm:h-5 bg-[#00b67a] flex items-center justify-center rounded-xs shadow-2xs">
        <svg class="w-3 h-3 text-white fill-current" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </div>
    {% endfor %}
  </div>
  <div class="text-xs font-semibold text-slate-700">
    <span class="font-extrabold text-slate-900">4,6</span> / 5
    <span class="text-slate-400 font-normal">({{ settings.trustpilot_review_count | default: '7 426 avis' }})</span>
  </div>
</div>
